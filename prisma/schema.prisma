generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Artist {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name String?
  specialty String?
  bio String?
  imageUrl String?

  products Product[]

  // Existing MongoDB documents may have null values
  createdAt DateTime?
  updatedAt DateTime?
}

model Product {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Basic artwork information
  slNo  Int?    @map("SL NO")
  title String? @map("TITLE")

  // Main image
  imageUrl String? @map("IMAGE URL")

  // Additional images
  image2 String? @map("IMAGE 2")
  image3 String? @map("IMAGE 3")
  image4 String? @map("IMAGE 4")
  image5 String? @map("IMAGE 5")

  // Artwork information
  referenceNo String? @map("REFERENCE NO")
  location    String? @map("LOCATION")
  year        Int?    @map("YEAR")
  medium      String? @map("MEDIUM")
  size        String? @map("SIZE")

  // Size-based prices
  price12x18 Float? @map("12X18 PRICE")
  price18x24 Float? @map("18X24 PRICE")
  price24x33 Float? @map("24X33 PRICE")

  // Website information
  category    String?
  description String?

  // Artist relationship
  artistId String? @db.ObjectId
  artist   Artist? @relation(fields: [artistId], references: [id])

  // Order items containing this product
  orderItems OrderItem[]
  cartItems  CartItem[]
  wishlists  Wishlist[]

  createdAt DateTime?
  updatedAt DateTime?
}

enum Role {
  USER
  ADMIN
}

model User {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String?
  email    String  @unique
  password String?

  role Role @default(USER)

  orders    Order[]
  wishlists Wishlist[]
  cartItems CartItem[]
}

enum OrderStatus {
  ORDER_PLACED
  PAYMENT_CONFIRMED
  ARTWORK_PREPARATION
  FRAMING
  QUALITY_CHECK
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  UPI
  CARD
  NETBANKING
  COD
}

model Order {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber String @unique

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  city            String
  state           String
  postalCode      String

  totalAmount Float
  currency    String @default("INR")

  paymentMethod PaymentMethod @default(RAZORPAY)
  paymentStatus PaymentStatus @default(PENDING)

  razorpayOrderId   String?
  razorpayPaymentId String?

  status         OrderStatus @default(ORDER_PLACED)
  courier        String?
  trackingNumber String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?  @db.ObjectId
  product   Product? @relation(fields: [productId], references: [id])

  title    String
  price    Float
  quantity Int

  size     String?
  frame    String?
  imageUrl String?
}

model FrameOption {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name     String @unique
  imageUrl String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size  String?
  frame String?

  price    Float
  quantity Int   @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FineArt {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  slNo Int? @map("Sl No")

  category String? @map("Category")

  artistName String? @map("Artist Name")

  itemRefNo String? @map("Item Ref No")

  year Int? @map("Year")

  image1 String? @map("Image 1")
  image2 String? @map("Image 2")
  image3 String? @map("Image 3")

  titleOfArt String? @map("Title of the Art")

  widthCms  String? @map("Width (CMS)")
  withFrame String? @map("With Frame")

  photo String? @map("Photo")

  paintingType String? @map("Painting Type")

  productCategory String? @map("Product Category")

  createdAt DateTime?
  updatedAt DateTime?
}

model Wishlist {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  productId String @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}
model Enquiry {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  firstName   String
  lastName    String
  email       String
  phone       String?
  inquiryType String
  message     String

  status String @default("NEW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
